# Database Configuration
POSTGRES_USER=investmentuser
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=investments
DATABASE_URL=postgresql://investmentuser:changeme_strong_password_here@db:5432/investments

# Backend Configuration
SECRET_KEY=changeme_generate_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# API Keys for Price Data
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=changeme_backup_encryption_key

# Application Settings
APP_NAME=Investment Tracker
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# Price Update Settings
PRICE_UPDATE_INTERVAL_MINUTES=15
PRICE_UPDATE_ENABLED=true

# Email Configuration (optional, for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@investmenttracker.com
